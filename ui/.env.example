# Copy to ui/.env.local for `npm run dev`, or set in the root .env for the Docker
# image (values are baked in at build time).

# Base map style. Defaults to the keyless CARTO Dark Matter style. Any
# MapLibre-compatible style URL works, e.g. MapTiler with your key:
# VITE_MAP_STYLE_URL=https://api.maptiler.com/maps/dataviz-dark/style.json?key=YOUR_MAPTILER_KEY
VITE_MAP_STYLE_URL=

# Leave empty to call the API on the same origin (Vite proxy / nginx). Set it to
# talk to the API directly, e.g. http://localhost:8000 (must be in CORS_ORIGINS).
VITE_API_BASE_URL=

# DLQ share (0-1) over the last few seconds that turns the DLQ monitor red.
VITE_DLQ_ALERT_RATIO=0.1
