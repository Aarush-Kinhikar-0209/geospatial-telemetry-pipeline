# ---------------------------------------------------------------------------
# .env.example
# Copy to `.env` (gitignored) and adjust. docker compose reads `.env` to fill
# the ${VAR} placeholders in docker-compose.yml.
# ---------------------------------------------------------------------------

# --- ClickHouse credentials (shared by the clickhouse and processor services)
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=change-me

# --- Generator load profile (defaults: 200 vehicles x 5 msg/s = ~1000 msg/s)
# For a slow, readable demo use VEHICLE_COUNT=1 and MESSAGE_INTERVAL=2.0.
VEHICLE_COUNT=200
MESSAGE_INTERVAL=0.2
CHAOS_PERCENTAGE=5
