# ---------------------------------------------------------------------------
# .env.example
# Copy to `.env` (gitignored) and adjust. docker compose reads `.env` to fill
# the ${VAR} placeholders in docker-compose.yml.
# ---------------------------------------------------------------------------

# --- ClickHouse credentials (shared by the clickhouse, processor and api services)
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=change-me

# --- Simulation (vehicles, interval and chaos are chosen in the UI, not here)
# How long one simulation runs before its telemetry is cleared
SIMULATION_DURATION_SECONDS=120
# A running simulation is ended and cleared when the page has sent no heartbeat
# for this long (the browser tab was closed, or lost its connection)
SIMULATION_HEARTBEAT_TIMEOUT_SECONDS=10

# --- Processor: DEBUG logs every record routed to the DLQ with its reason
PROCESSOR_LOG_LEVEL=INFO

# --- API: browser origins allowed by CORS (UI container, Vite dev server)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- UI image (baked in at build time: `docker compose up -d --build ui`)
# Empty = keyless CARTO Dark Matter. Any MapLibre style URL works, e.g.
# https://api.maptiler.com/maps/dataviz-dark/style.json?key=YOUR_MAPTILER_KEY
VITE_MAP_STYLE_URL=
# DLQ share (0-1) over the last 3 s that turns the DLQ monitor red
VITE_DLQ_ALERT_RATIO=0.1
